rules_version = '2';

// PokeBravara v2. Testadas no emulador (scripts em app/scripts/rules-test.mjs).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isProfessor() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('level', '') == 'Professor';
    }

    function isListedProfessor() {
      return request.auth.token.email in get(/databases/$(database)/documents/roles/professors).data.emails;
    }

    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Lista de e-mails de professores (editada pelo console).
    match /roles/{role} {
      allow get: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isProfessor());
      allow list: if isProfessor();

      // Cadastro: o próprio usuário. Treinador nasce sem time, PC, mochila, campanha ou PC liberado
      // e com no máximo o dinheiro inicial.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && (
          (request.resource.data.level == 'Treinador'
            && request.resource.data.keys().hasOnly(['level', 'realName', 'trainerName', 'gender', 'age', 'height', 'description',
                 'imageUrl', 'email', 'createdAt', 'trainerClass', 'attributes', 'skills', 'money'])
            && request.resource.data.get('money', 0) <= 3000)
          || (request.resource.data.level == 'Professor' && isListedProfessor()
            && request.resource.data.keys().hasOnly(['level', 'professorName', 'email', 'imageUrl', 'createdAt']))
        );

      // Dono: não se promove, não libera PC, não muda campanha nem insígnias;
      // dinheiro só diminui (compras); classe/atributos/perícias só na primeira vez (fichas antigas).
      // LIMITE CONHECIDO: time, PC e mochila continuam editáveis pelo dono (curar no Centro, usar item).
      allow update: if signedIn()
        && request.auth.uid == userId
        && !changed().hasAny(['level', 'pcUnlocked', 'campaign', 'email', 'createdAt', 'badges'])
        && (!changed().hasAny(['money']) || request.resource.data.money <= resource.data.get('money', 0))
        && (!changed().hasAny(['trainerClass', 'attributes', 'skills']) || !('trainerClass' in resource.data));

      // Mestre: só os campos que o painel edita, e só em treinadores.
      allow update: if isProfessor()
        && resource.data.get('level', '') == 'Treinador'
        && changed().hasOnly(['team', 'pc', 'bag', 'pcUnlocked', 'campaign', 'money', 'badges', 'trainerClass', 'attributes', 'skills']);

      allow delete: if false;

      match /pokedex/{pokemonId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isProfessor());
      }
    }

    // Campanhas: mapa, encontros, NPCs, facções. Todos leem; só o Mestre escreve.
    match /campaigns/{campaignId} {
      allow read: if signedIn();
      allow write: if isProfessor();
    }

    // Batalhas: o Mestre cria e resolve; cada jogador só escreve a própria ação.
    match /battles/{battleId} {
      allow read: if isProfessor() || (signedIn() && request.auth.uid in resource.data.participants);
      allow create, delete: if isProfessor();
      allow update: if isProfessor()
        || (signedIn()
          && request.auth.uid in resource.data.participants
          && resource.data.status == 'active'
          && changed().hasOnly(['actions'])
          && request.resource.data.actions.diff(resource.data.get('actions', {})).affectedKeys().hasOnly([request.auth.uid]));
    }
  }
}
